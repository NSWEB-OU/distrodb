{
  "name": "distrodb",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @distrodb/web dev",
    "dev:cms": "pnpm --filter @distrodb/cms dev",
    "build": "pnpm --filter ./apps/* build",
    "lint": "pnpm --filter ./apps/* lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "flatted": "^3.4.2"
    }
  }
}
