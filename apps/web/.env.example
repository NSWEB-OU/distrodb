CMS_URL=http://localhost:3001
RESEND_API_KEY=
# On-demand revalidation: must match apps/cms's REVALIDATE_SECRET. Leave empty
# to disable (falls back to the 1h revalidate window only).
REVALIDATE_SECRET=
# S3 bucket hostname serving media (see apps/cms S3_BUCKET/S3_REGION); must match
# the host in media URLs returned by the CMS for next/image remotePatterns.
NEXT_PUBLIC_MEDIA_HOSTNAME=
