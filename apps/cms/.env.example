DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/distrodb_cms
PAYLOAD_SECRET=YOUR_SECRET_HERE
PORT=3001

# On-demand revalidation: notifies apps/web to drop cached CMS responses right
# after a save/delete instead of waiting out the 1h ISR window. Leave empty to
# disable (falls back to the 1h revalidate window only).
REVALIDATE_SECRET=
WEB_URL=http://localhost:3000

# S3 storage for the media collection (logos/screenshots). Required in
# production (see PROJECT_CONTEXT.md Asset Structure); leave S3_BUCKET empty
# to use local disk storage for local dev only.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS S3-compatible providers (MinIO, R2, Spaces, etc.)
S3_ENDPOINT=

