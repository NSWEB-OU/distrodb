# Variables required by docker-compose.prod.yml. Copy to `.env` next to that
# file (docker compose auto-loads it) and fill in real values - never commit
# the filled-in `.env`.

# Postgres (self-hosted, same Docker network as the CMS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=distrodb_cms

# CMS (apps/cms)
PAYLOAD_SECRET=

# S3-compatible media storage - required in production (see PROJECT_CONTEXT.md)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS S3-compatible providers (MinIO, R2, Spaces, etc.)
S3_ENDPOINT=

# Web (apps/web)
NEXT_PUBLIC_MEDIA_HOSTNAME=
RESEND_API_KEY=
