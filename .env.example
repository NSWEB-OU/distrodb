# Variables required by docker-compose.prod.yml (single-VPS deployment), or
# docker-compose.cms.yml / docker-compose.web.yml (two separate Coolify
# resources - see each file's header comment). Copy to `.env` next to
# whichever file you use (docker compose auto-loads it) and fill in real
# values - never commit the filled-in `.env`.

# Postgres (self-hosted, same Docker network as the CMS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=distrodb_cms

# CMS (apps/cms)
PAYLOAD_SECRET=

# S3-compatible media storage - required in production (see PROJECT_CONTEXT.md)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS S3-compatible providers (MinIO, R2, Spaces, etc.)
S3_ENDPOINT=

# Web (apps/web)
# Only needed for docker-compose.web.yml (separate Coolify resources) - must
# point at the already-running cms resource's domain/FQDN. Not used by
# docker-compose.prod.yml, which hardcodes http://cms:3001 on its shared network.
CMS_URL=
NEXT_PUBLIC_MEDIA_HOSTNAME=
RESEND_API_KEY=
